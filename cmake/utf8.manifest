<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process's code page UTF-8 (Windows 10 1903+): the paths and text we
     hold in std::string, UTF-8, are what fopen(), fstreams and the rest of the
     narrow API take, a user name in any script included. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
