{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RATCAST_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "core",
      "displayName": "Debug, libraries only (no Qt)",
      "inherits": "debug",
      "cacheVariables": {
        "RATCAST_BUILD_APP": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "android",
      "displayName": "Android arm64, libraries and tools (NDK, vcpkg's arm64-android-release)",
      "description": "Needs ANDROID_NDK_ROOT and VCPKG_ROOT, and VCPKG_DEFAULT_HOST_TRIPLET where pkg-config is vcpkg's (Windows: x64-windows); tests run on the device adb sees (ANDROID_SERIAL when several).",
      "inherits": "debug",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android-release",
        "VCPKG_HOST_TRIPLET": "$env{VCPKG_DEFAULT_HOST_TRIPLET}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_shared",
        "RATCAST_BUILD_APP": "OFF"
      }
    },
    {
      "name": "android-app",
      "displayName": "Android arm64 with the app (Qt for Android)",
      "description": "As android, and QT_ANDROID (Qt's android_arm64_v8a), QT_HOST_PATH (the host's Qt) and ANDROID_SDK_ROOT; the package is the apk target.",
      "inherits": "android",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QT_ANDROID}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "RATCAST_BUILD_APP": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "RATCAST_BUILD_APP": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "android",
      "configurePreset": "android"
    },
    {
      "name": "android-app",
      "configurePreset": "android-app"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "As many tests at once as there are processors: CTEST_PARALLEL_LEVEL left empty (CMake 3.29+; one at a time before). \"jobs\": 0 would start them all at once.",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "CTEST_PARALLEL_LEVEL": ""
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "core",
      "inherits": "base",
      "configurePreset": "core"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "PIPEWIRE_DLCLOSE": "false",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/cmake/lsan.supp"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:suppressions=${sourceDir}/cmake/tsan.supp"
      }
    },
    {
      "name": "android",
      "description": "On one device: its processors are shared, and adb pushes over one link.",
      "inherits": "base",
      "configurePreset": "android",
      "execution": {
        "jobs": 4
      }
    }
  ]
}
