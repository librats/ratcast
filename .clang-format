# Formatting for ratcast's own code (external/ is never reformatted).
# CI checks it with the clang-format version pinned in .github/workflows/ci.yml.
# The first section is every language's; C++ and Objective-C++ (the engine's
# macOS backends, .mm) take it as it is.
---
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true

DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer

AllowShortFunctionsOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: true
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Empty
AllowShortLambdasOnASingleLine: All

BreakBeforeBraces: Attach
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine

SpacesBeforeTrailingComments: 2
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AlignConsecutiveDeclarations: false
AlignConsecutiveAssignments: false

# Own header first, then ratcast, then librats, then third-party and system —
# kept as written, one blank line between groups.
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
ObjCBlockIndentWidth: 4
---
Language: Cpp
---
Language: ObjC
...
